{
  "expo": {
    "name": "내 운동기록",
    "slug": "gymtracker-clean",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/splash-1.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/splash-1.png",
        "backgroundColor": "#5333ED"
      },
      "package": "com.lota1.gymtrackerclean",
      "versionCode": 5,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "blockedPermissions": [
        "com.google.android.gms.permission.AD_ID"
      ]
    },
    "plugins": [
      "expo-build-properties",
      "expo-font",
      "expo-image",
      "expo-sharing",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-1.png",
          "resizeMode": "contain",
          "backgroundColor": "#5333ED"
        }
      ],
      "expo-sqlite",
      "expo-status-bar",
      "expo-web-browser",
      [
        "expo-location",
        {
          "isAndroidBackgroundLocationEnabled": true,
          "locationAlwaysAndWhenInUsePermission": "운동 기록을 위해 백그라운드에서도 헬스장 도착 여부를 확인합니다."
        }
      ],
      [
        "expo-notifications",
        {
          "defaultChannel": "gym-reminders"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "c65030f8-f9a5-4ce2-b255-8048ae305dc1"
      }
    }
  }
}
