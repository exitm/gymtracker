{
  "expo": {
    "name": "내 운동기록",
    "slug": "gymtracker-clean",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/splash-1.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-1.png",
      "resizeMode": "contain",
      "backgroundColor": "#5333ED"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/splash-1.png",
        "backgroundColor": "#5333ED"
      },
      "package": "com.lota1.gymtrackerclean"
    },
    "plugins": [
      "expo-build-properties",
      "expo-font",
      "expo-image",
      "expo-sharing",
      "expo-splash-screen",
      "expo-sqlite",
      "expo-status-bar",
      "expo-web-browser",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "운동 기록을 위해 백그라운드에서도 헬스장 도착 여부를 확인합니다."
        }
      ]
    ]
  }
}